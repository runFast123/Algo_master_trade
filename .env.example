# Choice FINX Algo Trading Platform - configuration template
#
# Copy to .env and fill in. Never commit the real .env: the Choice OpenAPI
# Integration Guide s11.2 requires that credentials are not hard-coded or
# committed to version control.
#
# WHERE THIS FILE IS READ FROM, in priority order:
#   1. $CHOICE_ENV_FILE            explicit override, always wins
#   2. ./.env                      the working directory
#   3. next to the executable      for an installed desktop copy
#   4. %LOCALAPPDATA%\ChoiceFinxTrader\.env   (Windows; per-user, always writable)
#
# The backend logs which file it loaded at startup, so if a setting does not
# seem to apply, check that line first.

# ---------------------------------------------------------------- platform --

# "development" or "production". Production refuses to start without a
# SECRET_KEY, so a deployment can never run on an implicit default.
APP_ENV=development

# JWT signing key. Required in production, minimum 32 characters.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# How long a platform login lasts.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Leave unset to use the per-user application data directory (recommended for
# the desktop build). Example for a server deployment:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/algo
DATABASE_URL=

# Browser origins allowed to call the API. Leave empty for the desktop build,
# which is same-origin through its local proxy.
# CORS_ORIGINS=["https://app.example.com"]

# Interface the API binds to. Keep on loopback unless it sits behind a proxy.
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------ Choice --

# UAT  = https://uat.jiffy.in        sandbox, no real orders or money
# PROD = https://finxomne.choiceindia.com   live trading, real funds
#
# Stay on UAT until integration is certified by the Choice Open API team
# (Integration Guide s5.1 step 7 and s11.2).
CHOICE_ENV=UAT

# Optional explicit override of the base URL.
# CHOICE_BASE_URL=

# Network behaviour for every Choice call.
CHOICE_HTTP_TIMEOUT=15
CHOICE_HTTP_RETRIES=2
CHOICE_HTTP_BACKOFF=0.5

# Broker sessions expire after this long without use. The Choice 2FA token is
# valid for roughly 8 hours.
CHOICE_SESSION_TTL_SECONDS=28800

# ------------------------------------------------------- risk & compliance --

# SEBI/NSE cap unregistered strategies at 10 orders per second
# (Integration Guide s9). Raising this requires exchange strategy registration.
ORDER_RATE_LIMIT_PER_SEC=10

# Per-order ceilings applied before anything reaches Choice.
MAX_ORDER_VALUE=500000
MAX_ORDER_QUANTITY=100000

# ------------------------------------------------------------ partner OAuth --

# AES key issued per vendor by the Choice IT team. Partner callback parameters
# (cid, sid, accessToken) arrive AES-encrypted; baseUrl is plain text
# (Partner Product Integration Guide s6). Without this key the OAuth callback
# is disabled rather than trusting plaintext input.
# Accepts base64, hex, or raw 16/24/32-byte key material.
CHOICE_OAUTH_AES_KEY=
# Set only if Choice issues a fixed IV. Otherwise the IV is read from the
# first 16 bytes of the ciphertext.
CHOICE_OAUTH_AES_IV=

# ---------------------------------------------------- historical data provider --

# Provider to use for backtesting historical data:
#   AUTO     = Choice OpenAPI ChartData first; Yahoo Finance if Choice is empty/fails
#   CHOICE   = Choice OpenAPI ChartData only (no Yahoo fallback)
#   YFINANCE = Choice first, then Yahoo Finance
HISTORICAL_DATA_PROVIDER=AUTO
